# KeyBridge fastlane lanes.
#
#   ios_beta     — archive the iOS app with Apple cloud signing and upload to
#                  TestFlight.
#   mac_release  — archive the macOS menu-bar app, sign with Developer ID,
#                  notarize, and staple. (The Mac app installs a CGEventTap and
#                  therefore cannot be sandboxed, so it ships outside the Mac
#                  App Store — no TestFlight for macOS.)
#
# Both build the .xcodeproj that XcodeGen generates; CI runs `xcodegen generate`
# before invoking fastlane.

default_platform(:ios)

# Build the ASC API key once; it flows into pilot / notarize automatically.
def ci_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: false
  )
end

platform :ios do
  desc "Build and upload the iOS app to TestFlight"
  lane :ios_beta do
    api_key = ci_api_key
    setup_ci

    # Import the one cached Apple Development certificate (base64 .p12 secret)
    # so Xcode's cloud signing finds a valid identity and reuses it. Without
    # this, every CI run minted a fresh certificate — the account hit Apple's
    # certificate cap on 2026-07-18 and archiving died with "Choose a
    # certificate to revoke". Cloud signing itself stays on (it still manages
    # the provisioning profile); only the certificate is pinned.
    require "base64"
    require "tmpdir"
    dev_p12_path = File.join(Dir.tmpdir, "ios_dev.p12")
    File.binwrite(dev_p12_path, Base64.decode64(ENV.fetch("IOS_DEV_P12")))
    import_certificate(
      certificate_path: dev_p12_path,
      certificate_password: ENV.fetch("IOS_DEV_P12_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      path: "KeyBridge.xcodeproj",
      targets: ["KeyBridge-iOS"]
    )

    # Monotonic on main and recomputable from any checkout (needs
    # fetch-depth: 0 in the workflow). Re-running a run whose upload already
    # succeeded is rejected as a duplicate — push a new commit instead.
    increment_build_number(
      build_number: sh("git rev-list --count HEAD").strip,
      xcodeproj: "KeyBridge.xcodeproj"
    )

    build_app(
      project: "KeyBridge.xcodeproj",
      scheme: "KeyBridge-iOS",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ENV['ASC_KEY_PATH']} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Latest KeyBridge build."
    )
  end
end

platform :mac do
  desc "Build, notarize, and package the macOS app for Developer ID distribution"
  lane :mac_release do
    api_key = ci_api_key
    setup_ci

    # Import the Developer ID Application certificate (a base64-encoded .p12)
    # into the temporary CI keychain that setup_ci just created. This replaces
    # match — no certs repo, no passphrase, just two secrets.
    require "base64"
    require "tmpdir"
    p12_path = File.join(Dir.tmpdir, "devid.p12")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("DEVID_P12")))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV.fetch("DEVID_P12_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    # Manual Developer ID signing throughout: the CI keychain holds only the
    # imported Developer ID cert (no Apple Development cert, no ASC auth on
    # the archive step), so automatic signing would find no identity. A
    # non-sandboxed app with no restricted entitlements needs no profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      code_sign_identity: "Developer ID Application",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      path: "KeyBridge.xcodeproj",
      targets: ["KeyBridge-macOS"]
    )

    build_app(
      project: "KeyBridge.xcodeproj",
      scheme: "KeyBridge-macOS",
      export_method: "developer-id",
      output_directory: "output",
      output_name: "RemKeys",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Developer ID Application",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    notarize(
      package: "output/RemKeys.app",
      api_key: api_key,
      print_log: true
    )

    # Zip the stapled app for the GitHub Release.
    sh("cd output && ditto -c -k --keepParent RemKeys.app RemKeys-macOS.zip")
  end
end
