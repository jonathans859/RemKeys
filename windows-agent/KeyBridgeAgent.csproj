<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- net8.0-windows + WinForms for the tray icon (NotifyIcon). The publish
         is self-contained, so the Desktop runtime ships inside the zip and
         target PCs still need no install. EnableWindowsTargeting keeps the
         ubuntu CI build job compiling this Windows-only target. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KeyBridgeAgent</RootNamespace>
    <AssemblyName>KeyBridgeAgent</AssemblyName>
    <!-- Windowless: the logon task must not spawn a closable console window.
         All output goes to the file logger; stop via uninstall-agent.bat or
         Task Scheduler, not by closing a window. -->
    <OutputType>WinExe</OutputType>
    <!-- Generic host + file logging; no third-party runtime deps. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
